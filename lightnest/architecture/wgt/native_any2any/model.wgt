parameter enc0_n1_bias:f32[H]=zeros()
parameter enc0_n2_weight:f32[H]=ones()
parameter enc0_n2_bias:f32[H]=zeros()
parameter enc1_q_weight:f32[H,H]=zeros()
parameter enc1_q_bias:f32[H]=zeros()
parameter enc1_k_weight:f32[H,H]=zeros()
parameter enc1_k_bias:f32[H]=zeros()
