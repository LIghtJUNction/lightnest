wgt 0.5
dim H
dim H2
dim H4
dim A
dim D
dim SEQ
dim G
dim GT
dim GG
dim GH
dim RQ
dim P
dim S
dim SP
dim SH
dim N
dim NH
dim DEPTH
dim B
import recurrent from "std/recurrent"
model NativeArtifactCore
# Ordinary WGT: all parameter-dependent encoder, notebook, recurrent thinking and heads stay in one graph.
# G sampled chunks each have SEQ padded positions; attention masks keys, and means ignore padded queries.
# A independent heads each have D=H/A channels. Four encoder layers have independent parameters.
# Dropout takes explicit seed/training data; each chunk/layer/site gets a distinct stream.
# Zero/one recipes are untrained storage; import original weights explicitly.
parameter byte_weight:f32[257,H]=zeros()
parameter kind_weight:f32[256,H]=zeros()
parameter position_weight:f32[P,H]=zeros()
parameter enc0_q_weight:f32[H,H]=zeros()
parameter enc0_q_bias:f32[H]=zeros()
parameter enc0_k_weight:f32[H,H]=zeros()
parameter enc0_k_bias:f32[H]=zeros()
parameter enc0_v_weight:f32[H,H]=zeros()
parameter enc0_v_bias:f32[H]=zeros()
parameter enc0_out_weight:f32[H,H]=zeros()
parameter enc0_out_bias:f32[H]=zeros()
parameter enc0_ff1_weight:f32[H4,H]=zeros()
parameter enc0_ff1_bias:f32[H4]=zeros()
parameter enc0_ff2_weight:f32[H,H4]=zeros()
parameter enc0_ff2_bias:f32[H]=zeros()
