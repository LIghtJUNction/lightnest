wgt 0.5
dim H
dim H2
dim C
import recurrent from "std/recurrent"
model NativeHNetELFGenerator
# Complete H-Net ELF generation: three independent chunk GRUs plus the shared
# red cell. Five explicit decoder states carry key and EMA gradients across
# positions. Parameters are zero-initialized UNTRAINED storage; restore first.
# Chunk mode chooses dynamic confidence STE, fixed boundaries, or dense updates.
# Candidates are evaluated on all positions; no sparse-compute speedup claimed.
parameter byte_weight:f32[257,H]=zeros()
parameter position_weight:f32[C,H]=zeros()
parameter mode_weight:f32[3,H]=zeros()
parameter condition_weight:f32[H,72]=zeros()
parameter condition_bias:f32[H]=zeros()
parameter red_xr_weight:f32[H,H2]=zeros()
parameter red_xr_bias:f32[H]=zeros()
parameter red_xz_weight:f32[H,H2]=zeros()
parameter red_xz_bias:f32[H]=zeros()
parameter red_xn_weight:f32[H,H2]=zeros()
parameter red_xn_bias:f32[H]=zeros()
parameter red_hr_weight:f32[H,H]=zeros()
parameter red_hr_bias:f32[H]=zeros()
parameter red_hz_weight:f32[H,H]=zeros()
parameter red_hz_bias:f32[H]=zeros()
parameter red_hn_weight:f32[H,H]=zeros()
parameter red_hn_bias:f32[H]=zeros()
parameter blue_bits_weight:f32[8,H]=zeros()
parameter blue_bits_bias:f32[8]=zeros()
parameter red_bits_weight:f32[8,H]=zeros()
parameter red_bits_bias:f32[8]=zeros()
parameter stop_weight:f32[1,H]=zeros()
parameter stop_bias:f32[1]=zeros()
parameter copy_query_weight:f32[H,H]=zeros()
parameter copy_gate_weight:f32[1,H]=zeros()
parameter copy_gate_bias:f32[1]=zeros()
parameter norm_weight:f32[H]=ones()
parameter norm_bias:f32[H]=zeros()
parameter copy_keys_weight:f32[9,H]=zeros()
parameter encoder_xr_weight:f32[H,H2]=zeros()
parameter encoder_xr_bias:f32[H]=zeros()
parameter encoder_xz_weight:f32[H,H2]=zeros()
parameter encoder_xz_bias:f32[H]=zeros()
parameter encoder_xn_weight:f32[H,H2]=zeros()
parameter encoder_xn_bias:f32[H]=zeros()
parameter encoder_hr_weight:f32[H,H]=zeros()
parameter encoder_hr_bias:f32[H]=zeros()
parameter encoder_hz_weight:f32[H,H]=zeros()
parameter encoder_hz_bias:f32[H]=zeros()
parameter encoder_hn_weight:f32[H,H]=zeros()
parameter encoder_hn_bias:f32[H]=zeros()
parameter main_xr_weight:f32[H,H]=zeros()
parameter main_xr_bias:f32[H]=zeros()
parameter main_xz_weight:f32[H,H]=zeros()
parameter main_xz_bias:f32[H]=zeros()
parameter main_xn_weight:f32[H,H]=zeros()
parameter main_xn_bias:f32[H]=zeros()
parameter main_hr_weight:f32[H,H]=zeros()
parameter main_hr_bias:f32[H]=zeros()
parameter main_hz_weight:f32[H,H]=zeros()
parameter main_hz_bias:f32[H]=zeros()
parameter main_hn_weight:f32[H,H]=zeros()
parameter main_hn_bias:f32[H]=zeros()
parameter decoder_xr_weight:f32[H,H]=zeros()
parameter decoder_xr_bias:f32[H]=zeros()
parameter decoder_xz_weight:f32[H,H]=zeros()
parameter decoder_xz_bias:f32[H]=zeros()
parameter decoder_xn_weight:f32[H,H]=zeros()
parameter decoder_xn_bias:f32[H]=zeros()
parameter decoder_hr_weight:f32[H,H]=zeros()
parameter decoder_hr_bias:f32[H]=zeros()
parameter decoder_hz_weight:f32[H,H]=zeros()
parameter decoder_hz_bias:f32[H]=zeros()
parameter decoder_hn_weight:f32[H,H]=zeros()
parameter decoder_hn_bias:f32[H]=zeros()
parameter query_weight:f32[H,H]=zeros()
parameter key_weight:f32[H,H]=zeros()
parameter skip_weight:f32[H,H]=zeros()
parameter encoder_norm_weight:f32[H]=ones()
parameter encoder_norm_bias:f32[H]=zeros()
parameter main_norm_weight:f32[H]=ones()
parameter main_norm_bias:f32[H]=zeros()
parameter output_norm_weight:f32[H]=ones()
parameter output_norm_bias:f32[H]=zeros()
fn normalize(value) { return scale(value,[1]/clip(sqrt(sum(value*value)),0.000001,1.0e30)); }
fn red_step(red_input,hidden,red_xr_weight,red_xr_bias,red_xz_weight,red_xz_bias,red_xn_weight,red_xn_bias,red_hr_weight,red_hr_bias,red_hz_weight,red_hz_bias,red_hn_weight,red_hn_bias,norm_weight,norm_bias) {
 let candidate=recurrent.gru_cell(((((red_xr_weight as [H,H2]) @ (red_input as [H2,1])) as [H])+red_xr_bias),((((red_xz_weight as [H,H2]) @ (red_input as [H2,1])) as [H])+red_xz_bias),((((red_xn_weight as [H,H2]) @ (red_input as [H2,1])) as [H])+red_xn_bias),((((red_hr_weight as [H,H]) @ (hidden as [H,1])) as [H])+red_hr_bias),((((red_hz_weight as [H,H]) @ (hidden as [H,1])) as [H])+red_hz_bias),((((red_hn_weight as [H,H]) @ (hidden as [H,1])) as [H])+red_hn_bias),hidden);
 return layer_norm(candidate,norm_weight,norm_bias,0,0.00001);
}
fn forward(previous:f32[1],position:f32[1],mode:f32[1],requested:f32[9,8],encoder:f32[H],main:f32[H],decoder:f32[H],key:f32[H],smooth:f32[H],active:f32[16],attention_scale:f32[1],first:f32[1],fixed:f32[1],chunk_mode:f32[3])->(f32[8],f32[8],f32[1],f32[H],f32[H],f32[H],f32[H],f32[H],f32[1],f32[1]){
 let token=embedding(byte_weight as [257,H],previous) as [H];
 let pos=embedding(position_weight as [C,H],position) as [H];
 let kind=embedding(mode_weight as [3,H],mode) as [H];
 let context=linear(requested as [72],condition_weight,condition_bias)+kind;
 let inputs=concat(token+pos,context,0);
 let next_encoder=recurrent.gru_cell(linear(inputs,encoder_xr_weight,encoder_xr_bias),linear(inputs,encoder_xz_weight,encoder_xz_bias),linear(inputs,encoder_xn_weight,encoder_xn_bias),linear(encoder,encoder_hr_weight,encoder_hr_bias),linear(encoder,encoder_hz_weight,encoder_hz_bias),linear(encoder,encoder_hn_weight,encoder_hn_bias),encoder);
 let encoded=layer_norm(next_encoder,encoder_norm_weight,encoder_norm_bias,0,0.00001);
 let next_key=normalize(linear(encoded,key_weight));
 let q=normalize(linear(encoded,query_weight));
 let predicted=route(first,[1],clip(scale([1]-sum(q*key),0.5),0,1));
 let probability=route(chunk_mode[0],predicted,route(chunk_mode[1],fixed,[1]));
 let hard=topk_mask(concat(probability,[1]-probability,0),[1]);
 let boundary=hard[0];
 let candidate=recurrent.gru_cell(linear(encoded,main_xr_weight,main_xr_bias),linear(encoded,main_xz_weight,main_xz_bias),linear(encoded,main_xn_weight,main_xn_bias),linear(main,main_hr_weight,main_hr_bias),linear(main,main_hz_weight,main_hz_bias),linear(main,main_hn_weight,main_hn_bias),main);
 let next_main=route(boundary,candidate,main);
 let main_value=layer_norm(candidate,main_norm_weight,main_norm_bias,0,0.00001);
 let candidate_smooth=scale(main_value,probability)+scale(smooth,[1]-probability);
 let next_smooth=route(boundary,candidate_smooth,smooth);
 # Preserve the original confidence STE only for dynamic mode; state carries
 # the actual EMA, not the auxiliary straight-through confidence multiplier.
 let confidence=route(boundary,probability,[1]-probability);
 let expanded=scale(next_smooth,route(chunk_mode[0],[1]+confidence-detach(confidence),[1]));
 let combined=linear(encoded,skip_weight)+expanded;
 let next_decoder=recurrent.gru_cell(linear(combined,decoder_xr_weight,decoder_xr_bias),linear(combined,decoder_xz_weight,decoder_xz_bias),linear(combined,decoder_xn_weight,decoder_xn_bias),linear(decoder,decoder_hr_weight,decoder_hr_bias),linear(decoder,decoder_hz_weight,decoder_hz_bias),linear(decoder,decoder_hn_weight,decoder_hn_bias),decoder);
 let base=layer_norm(next_decoder,output_norm_weight,output_norm_bias,0,0.00001);
 let red_input=concat(base,context,0);
 let thought=repeat 16 indexed i carrying hidden=base { route(active[i],red_step(red_input,hidden,red_xr_weight as [H,H2],red_xr_bias,red_xz_weight as [H,H2],red_xz_bias,red_xn_weight as [H,H2],red_xn_bias,red_hr_weight as [H,H],red_hr_bias,red_hz_weight as [H,H],red_hz_bias,red_hn_weight as [H,H],red_hn_bias,norm_weight,norm_bias),hidden) };
 # attention is over exactly nine requested bytes; no padding or causal mask.
 let copy_q=linear(thought,copy_query_weight) as [1,H];
 let scores=scale((copy_q @ (copy_keys_weight as [9,H]).T) as [9],attention_scale);
 let copied=((softmax(scores) as [1,9]) @ requested) as [8];
 let gate=sigmoid(linear(thought,copy_gate_weight,copy_gate_bias));
 let red_logits=linear(thought,red_bits_weight,red_bits_bias);
 let copied_logits=scale(copied,24)-[12,12,12,12,12,12,12,12];
 let bits=route(gate,copied_logits,red_logits);
 return (bits,linear(base,blue_bits_weight,blue_bits_bias),linear(thought,stop_weight,stop_bias),next_encoder,next_main,next_decoder,next_key,next_smooth,probability,boundary);
}
