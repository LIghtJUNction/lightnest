wgt 0.5
target torch
host experiments.active.elf_generation.models
extern torch, nn

model Candidate extends Module {
    init(self, variant, width, capacity) {
        super().__init__();
        self.variant, self.width, self.capacity = (variant, width, capacity);
        self.position = nn.Embedding(capacity + 1, width);
        self.request = nn.Linear(73, width);
        self.norm = nn.LayerNorm(width);
        if variant == 'mlp' {
            self.core = nn.Sequential(nn.Linear(width, 2 * width), nn.GELU(), nn.Linear(2 * width, width));
        }
        elif variant == 'gru' {
            self.core = nn.GRU(width, width, 2, batch_first=True);
        }
        elif variant == 'conv' {
            self.core = nn.Sequential(nn.Conv1d(width, width, 5, padding=2), nn.GELU(), nn.Conv1d(width, width, 5, padding=2));
        }
        elif variant == 'transformer' {
            layer = nn.TransformerEncoderLayer(width, 4, 2 * width, dropout=0., batch_first=True);
            self.core = nn.TransformerEncoder(layer, 2, enable_nested_tensor=False);
        }
        else {
            raise ValueError('unknown architecture');
        }
        self.output = nn.Linear(width, 9);
    }
    fn forward(self, condition) {
        values = condition[:, 1:];
        bits = (values[..., None] >> torch.arange(8, device=values.device) & 1).float().flatten(1);
        request = torch.cat((condition[:, :1].float(), bits), -1);
        x = self.position.weight[None] + self.request(request)[:, None];
        if self.variant == 'gru' {
            y, _ = self.core(x);
        }
        elif self.variant == 'conv' {
            y = self.core(x.transpose(1, 2)).transpose(1, 2);
        }
        else {
            y = self.core(x);
        }
        return self.output(self.norm(x + y));
    }
}
